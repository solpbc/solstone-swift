      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "this journal's identity doesn't match the pairing code. double-check which journal you're pairing, then try again with a new code."
          }
        }
      }
    },
    "m696f732e70616972696e672e6d6573736167653133": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
