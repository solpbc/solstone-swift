    "m696f732e736166617269736f757263652e616c6c6f77657874656e73696f6e": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Extension"
          }
        }
      }
    },
    "m696f732e736166617269736f757263652e616c77617973616c6c6f77": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Always Allow"
          }
        }
      }
    },
    "m696f732e736166617269736f757263652e6177616974696e676d61726b": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "starts once you confirm your journal's mark."
          }
        }
      }
    },
    "m696f732e736166617269736f757263652e63616c656e646172": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "last page from Safari: %1$@"
          }
        }
      }
    },
    "m696f732e736166617269736f757263652e63686f6f7365616c77617973616c6c6f77736f6974": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "choose Always Allow so it keeps working when you come back."
          }
        }
      }
    },
    "m696f732e736166617269736f757263652e657874656e73696f6e73": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "extensions"
          }
        }
      }
    },
    "m696f732e736166617269736f757263652e666c6970616c6c6f77657874656e73696f6e696e73657474696e6773": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "flip Allow Extension in Settings. to put every site in your journal, also set All Websites (or Other Websites) to Allow, further down the same page. then come back here."
          }
        }
      }
    },
    "m696f732e736166617269736f757263652e66756c6c": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "this device is out of storage for Safari pages. free up some space and new pages go into your journal again."
          }
        }
      }
    },
    "m696f732e736166617269736f757263652e66756c6c636f6d70616374": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "out of storage."
          }
        }
      }
    },
    "m696f732e736166617269736f757263652e6966616c6c77656273697465736f726f74686572": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "if All Websites (or Other Websites) is set to Allow in Settings, every site you don't leave out goes into your journal. set it back to Ask to add sites one at a time."
          }
        }
      }
    },
    "m696f732e736166617269736f757263652e696e7361666172696f70656e74686570616765": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "in Safari, open the page menu, then Manage Extensions, and turn on solstone."
          }
        }
      }
    },
    "m696f732e736166617269736f757263652e696e736166617269746170746865657874656e73696f6e73": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "in Safari, tap the extensions button in the address bar and turn on solstone."
          }
        }
      }
    },
    "m696f732e736166617269736f757263652e696e73657474696e6773676f746f61707073": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "in Settings, go to Apps, Safari, Extensions, solstone. with Allow Extension on, set All Websites (or Other Websites) to Allow. that's every website, including ones you visit later. you can leave sites out."
          }
        }
      }
    },
    "m696f732e736166617269736f757263652e697473776f726b696e67": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "it's working."
          }
        }
      }
    },
    "m696f732e736166617269736f757263652e6e6f706167657366726f6d736166617269796574": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "no pages from Safari yet. on a site you want in your journal, open solstone from the extensions button in Safari's address bar and add it."
          }
        }
      }
    },
    "m696f732e736166617269736f757263652e6e6f70616765796574": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "no pages from Safari yet. on a site you want in your journal, open solstone from Safari's page menu and add it."
          }
        }
      }
    },
    "m696f732e736166617269736f757263652e6e6f7468696e6777616974696e67": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "nothing from Safari is waiting on this device."
          }
        }
      }
    },
    "m696f732e736166617269736f757263652e6e6f746f6e796574696673657474696e6773": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "not on yet. if Settings opened somewhere else, go to Apps, Safari, Extensions, solstone. the switch is Allow Extension."
          }
        }
      }
    },
    "m696f732e736166617269736f757263652e6e6f74706169726564": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "nothing is taken in until you pair."
          }
        }
      }
    },
    "m696f732e736166617269736f757263652e6f6e63656974737365746f70656e616e79": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "once it's set, open any site in Safari, then open solstone from the page menu to check it's on."
          }
        }
      }
    },
    "m696f732e736166617269736f757263652e6f6e63656974737365746f70656e616e7932": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "once it's set, open any site in Safari, then open solstone from the extensions button in the address bar to check it's on."
          }
        }
      }
    },
    "m696f732e736166617269736f757263652e6f6e65737769746368696e73657474696e6773666c6970": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "one switch in Settings. flip it, then come back here."
          }
        }
      }
    },
