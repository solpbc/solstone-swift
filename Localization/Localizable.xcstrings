    "m696f732e736f75726365766f636162756c61727966696e69736873796e63696e672e746865736f6c73746f6e6561707073796e6373746f796f75726a6f75726e616c7768696c656974736f70656e61": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
