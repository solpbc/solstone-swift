    "m696f732e736166617269736f757263652e736f6c73746f6e65697366757274686572646f776e746865": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "solstone is further down the page menu. choose Always Allow so it keeps working when you come back."
          }
        }
      }
    },
    "m696f732e736166617269736f757263652e746865657874656e73696f6e69736f66667475726e": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "the extension is off. turn it on in Settings to start intake."
          }
        }
      }
    },
    "m696f732e736166617269736f757263652e746f7475726e69746f6e6f72": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "to turn it on or off, in Safari, open the page menu, then Manage Extensions."
          }
        }
      }
    },
    "m696f732e736166617269736f757263652e746f7475726e69746f6e6f7232": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "to turn it on or off, in Safari, tap the extensions button in the address bar, then Manage Extensions."
          }
        }
      }
    },
    "m696f732e736166617269736f757263652e7475726e69746f6e6f726f6666": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "turn it on or off in Settings. to put every site in your journal, set All Websites (or Other Websites) to Allow there. to change one site, open it, then open solstone from Safari's page menu."
          }
        }
      }
    },
    "m696f732e736166617269736f757263652e7475726e69746f6e6f726f666632": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "turn it on or off in Settings. to put every site in your journal, set All Websites (or Other Websites) to Allow there. to change one site, open it, then open solstone from the extensions button in Safari's address bar."
          }
        }
      }
    },
    "m696f732e736166617269736f757263652e7475726e6f6e746865657874656e73696f6e": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "turn on the extension"
          }
        }
      }
    },
    "m696f732e736166617269736f757263652e756e7265616461626c65": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "this app can't check for Safari pages on this device right now."
          }
        }
      }
    },
    "m696f732e736166617269736f757263652e756e7265616461626c65636f6d70616374": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "can't check right now."
          }
        }
      }
    },
    "m696f732e736166617269736f757263652e76616c75656c696e65": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "on the sites you allow in Safari, the solstone extension takes in the page's text and rough layout, and all of it goes into your journal."
          }
        }
      }
    },
    "m696f732e736166617269736f757263652e77616974696e67": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "some pages are waiting on this device."
          }
        }
      }
    },
    "m696f732e736166617269736f757263652e77616974696e67666f72617061676566726f6d": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "waiting for a page from %1$@."
          }
        }
      }
    },
    "m696f732e736166617269736f757263652e776869636873697465": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "which site?"
          }
        }
      }
    },
    "m696f732e736166617269736f757263652e77686963687369746573646f796f7577616e74": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "which sites do you want in your journal?"
          }
        }
      }
    },
    "m696f732e736166617269736f757263652e7768696c65636c6f736564": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "while this is on, the solstone extension keeps taking in pages from the sites you allow, even when this app is closed. pages wait on this device and go into your journal the next time you open this app."
          }
        }
      }
    },
    "m696f732e736166617269736f757263652e77697468616c6c6f77657874656e73696f6e6f6e736574": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "with Allow Extension on, set All Websites (or Other Websites) to Allow in Settings. that's every website, including ones you visit later. you can leave sites out."
          }
        }
      }
    },
    "m696f732e736166617269736f757263652e796f75726669727374706167656a75737463616d65": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "your first page just came in. it's on its way to your journal."
          }
