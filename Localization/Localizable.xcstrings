    "m696f732e70616972696e672e6d6573736167652e6e61746976652e6279746573": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "this device and your journal are on different networks.\nthis device: %1$@\nyour journal: %2$@\nconnect both to the same wi-fi, then try again.\nturning on private network on your journal lets your devices reach it from anywhere."
          }
        }
      }
    },
    "m696f732e70616972696e672e6d6573736167653130": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "the pairing window closed. show a new pairing code on your journal, then try again."
          }
        }
      }
    },
    "m696f732e70616972696e672e6d6573736167653131": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "the relay connected to the wrong journal."
          }
