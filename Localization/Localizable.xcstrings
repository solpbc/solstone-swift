    "m696f732e73637265656e73686f74732e696f73697373686172696e676f6e6c7974686532": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "ios is sharing only the photos you picked, so new screenshots can't come in. allow full access in ios settings."
