    },
    "m696f732e70616972696e672e6d6573736167653136": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "this pairing link uses an unsupported verification format."
          }
        }
      }
    },
    "m696f732e70616972696e672e6d6573736167653137": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "your journal isn't reachable from here. you're on cellular, and pairing needs to reach your journal directly. join the same wi-fi as your journal, or try again when you're home. everything the solstone app has taken in is on this device and syncs once you reconnect."
          }
        }
      }
    },
    "m696f732e70616972696e672e6d65737361676532": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "couldn't reach your journal at %1$@. make sure it's running and on the same wi-fi, then try again. some networks block devices from connecting directly. turning on private network on your journal lets your devices reach it from anywhere."
          }
        }
      }
    },
    "m696f732e70616972696e672e6d65737361676533": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "couldn't reach your journal at %1$@. make sure it's running, then try again."
          }
        }
      }
    },
    "m696f732e70616972696e672e6d65737361676534": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "couldn't reach your journal. make sure it's running and on the same wi-fi, then try again. turning on private network on your journal lets your devices reach it from anywhere."
          }
