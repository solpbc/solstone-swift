# App Store Connect / TestFlight operator config for `make testflight`.
#
# Copy this file to config/testflight.env (gitignored) and fill in your own
# values. These identify YOUR App Store Connect API key and TestFlight group —
# they are account-specific and must never be committed.
#
# This file is read as a Makefile fragment (`make` include syntax), so `$(HOME)`
# and other make variables work in the values.

# App Store Connect API key ID
# (App Store Connect -> Users and Access -> Integrations -> App Store Connect API).
ASC_KEY_ID = XXXXXXXXXX

# App Store Connect API issuer ID (same Integrations page).
ASC_ISSUER = 00000000-0000-0000-0000-000000000000

# Absolute path to your downloaded .p8 private key. Keep it OUTSIDE the repo.
ASC_KEY_PATH = $(HOME)/.config/app-store-connect/AuthKey.p8

# Name of the TestFlight internal testing group to release builds to
# (must already exist in App Store Connect -> your app -> TestFlight).
TESTFLIGHT_GROUP = My Testers
